@@ -8,2 +8,3 @@ fi
 
+module load innovus/21.1
 module load pegasus/21.3
@@ -44,5 +45,38 @@ CELLS=`cat ${CDL_FILE} | grep -i .SUBCKT | awk '{print $2}'`
 
+# Gate the flow on the Pegasus LVS verdict. Anything other than an explicit
+# MATCH means the layout does not implement the netlist it claims to, so any
+# downstream PEX / Quantus / Liberate result would describe a different circuit
+# than the .cdl. Abort instead of continuing to characterization.
+check_lvs_verdict() {
+	_cell=$1
+	_log=$2
+
+	if [ ! -r "${_log}" ]; then
+		echo "ERROR: LVS log for cell '${_cell}' is missing or unreadable: ${_log}" >&2
+		echo "ERROR: cannot confirm layout-vs-schematic equivalence. Aborting before PEX/characterization." >&2
+		exit 1
+	fi
+
+	_verdict=`grep -E '^[[:space:]]*#[[:space:]]*Run Result[[:space:]]*:' "${_log}" | head -1 | sed -e 's/.*Run Result[[:space:]]*:[[:space:]]*//' -e 's/[[:space:]]*#*[[:space:]]*$//'`
+
+	if [ -z "${_verdict}" ]; then
+		echo "ERROR: no LVS 'Run Result' verdict found in ${_log} for cell '${_cell}'." >&2
+		echo "ERROR: the LVS run did not complete. Aborting before PEX/characterization." >&2
+		exit 1
+	fi
+
+	if [ "${_verdict}" != "MATCH" ]; then
+		echo "ERROR: LVS ${_verdict} for cell '${_cell}' (log: ${_log})." >&2
+		echo "ERROR: layout does not match the source netlist ${CDL_FILE}." >&2
+		echo "ERROR: refusing to run PEX/Quantus/Liberate on a mismatched cell." >&2
+		exit 1
+	fi
+
+	echo "LVS MATCH confirmed for cell '${_cell}'"
+}
+
 for CELL in $CELLS; do
+	export LVS_LOG_FILE="${LOG_DIR}/${CELL}_${LIB_NAME}.lvs.log"
+
 	if [ ! -e ${DONE_DIR}/${CELL}_${LIB_NAME}_lvs.done ]; then
-		export LVS_LOG_FILE="${LOG_DIR}/${CELL}_${LIB_NAME}.lvs.log"
 
@@ -56,5 +90,12 @@ for CELL in $CELLS; do
 			-layout_top_cell ${CELL} \
-			${PVL_FILE} |& tee ${LVS_LOG_FILE} 
+			${PVL_FILE} |& tee ${LVS_LOG_FILE}
+
+		check_lvs_verdict "${CELL}" "${LVS_LOG_FILE}"
 
 		touch ${DONE_DIR}/${CELL}_${LIB_NAME}_lvs.done
+	else
+		# A done-marker only records that LVS ran, not that it passed. Markers
+		# written before this check existed can mark a MISMATCH cell as done, so
+		# re-read the verdict on the skip path too.
+		check_lvs_verdict "${CELL}" "${LVS_LOG_FILE}"
 	fi
