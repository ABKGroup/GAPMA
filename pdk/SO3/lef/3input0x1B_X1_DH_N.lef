        RECT 0.0530 0.0770 0.0670 0.0910 ;
        RECT 0.0530 0.1730 0.0670 0.1870 ;
        RECT 0.3230 0.0770 0.3370 0.0910 ;
        RECT 0.3230 0.1730 0.3370 0.1870 ;
        RECT 0.1130 0.0530 0.1270 0.0670 ;
        RECT 0.1130 0.2210 0.1270 0.2350 ;
        RECT 0.2030 0.0290 0.2170 0.0430 ;
        RECT 0.2030 0.2210 0.2170 0.2350 ;
      LAYER M1 ;
