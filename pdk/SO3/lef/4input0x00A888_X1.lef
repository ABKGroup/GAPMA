    PORT
      LAYER M1 ;
        RECT 0.1720 0.0240 0.1870 0.1200 ;
      LAYER M0 ;
        RECT 0.1680 0.1010 0.2140 0.1150 ;
        RECT 0.1450 0.0290 0.1920 0.0430 ;
    END
  END Y
  PIN VDD
